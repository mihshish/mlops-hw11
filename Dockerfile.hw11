FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY lab11/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY release.py backends.py /app/
COPY lab11/ /app/lab11/
USER 10001:10001
EXPOSE 8080
CMD ["python","-m","uvicorn","lab11.app:app","--host","0.0.0.0","--port","8080","--timeout-graceful-shutdown","35","--no-access-log"]
